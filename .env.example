# Copier ce fichier en .env avant de lancer docker compose

# Base de données
POSTGRES_DB=pasdeplaneteb
POSTGRES_USER=pdpb
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://pdpb:changeme@postgres:5432/pasdeplaneteb

# API
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Jeton pour protéger les endpoints POST /api/admin/ingest/* — à générer soi-même (ex: openssl rand -hex 32)
INGEST_TOKEN=changeme-token-secret
# Clé gratuite NASA FIRMS, à obtenir sur https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Clé API Infoclimat (stations météo de référence, migration 062) — à générer
# sur https://www.infoclimat.fr/opendata/, liée à l'IP du serveur qui exécute
# l'ingestion (le VPS de prod, pas une machine locale ni GitHub Actions).
INFOCLIMAT_API_TOKEN=
# Secret TOTP pour l'authentification admin (voir README, section Sécurité)
ADMIN_TOTP_SECRET=
# Traduction automatique dans l'admin (optionnel) — clé Google Cloud Translation,
# https://console.cloud.google.com/apis/library/translate.googleapis.com
GOOGLE_TRANSLATE_API_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Registry (rempli en CI, pas en local)
REGISTRY=ghcr.io/votre-org/pas-de-planete-b
